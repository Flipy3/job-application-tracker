{
  "manifest_version": 3,
  "name": "求职进度追踪器",
  "version": "0.1.0",
  "description": "用于保存求职岗位记录的浏览器扩展。",
  "action": {
    "default_title": "求职进度追踪器",
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://www.jobtrackerzephyr.xyz/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
